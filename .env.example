# TPUaaS (Coral EdgeTPU-as-a-Service) Configuration Template
# Copy this file to .env and customize for your environment.

# HTTP/WebSocket Server Port
TPUAAS_PORT=8090

# Default Server URL used by TPUaaSClient SDK
TPUAAS_URL=http://localhost:8090

# Base directory containing models/ and data/
# TPUAAS_BASE_DIR=/opt/tpuaas

# Optional: Self-contained pycoral/tflite_runtime directory
# TPUAAS_RUNTIME_DIR=/opt/tpuaas/runtime

# Optional: Live MQTT Lightshow / Ambilight Beat & Color Sync Bridge
# Leave TPUAAS_MQTT_HOST empty to disable the background MQTT subscriber.
TPUAAS_MQTT_HOST=
TPUAAS_MQTT_PORT=1883
TPUAAS_MQTT_USER=
TPUAAS_MQTT_PASS=
TPUAAS_MQTT_TOPICS=rpmlight/#

# Optional: Local Voice Engine (UDP 16kHz S16_LE PCM port + Tier 2 Gemini Flash-Lite fallback)
TPUAAS_VOICE_UDP_PORT=8092
TPUAAS_ASSISTANT_NAME=Atlas
TPUAAS_TOPIC_PREFIX=tpuaas
TPUAAS_WAKE_WORDS=atlas,hey atlas,okay atlas
TPUAAS_WAKE_STRIP_TOKENS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_CAP=50
GEMINI_MAX_OUTPUT_TOKENS=150
